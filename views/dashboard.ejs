<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
</head>
<body>
    hello <%= locals.currentUser.username %>
    <%- include('partials/displaySubFolders', {folders: locals.folders}) %>
    <%- include('partials/displayFiles', {files: locals.files}) %>
    <form action="<%= locals.folderUrl %>/upload" method="post" enctype="multipart/form-data">
        <label for="fileBackup">Upload your file: </label>
        <input type="file" name="fileBackup" id="fileBackup">
        <button type="submit">Upload</button>
    </form>
    <a href="/dashboard/<%=currentUser.username%>/create">create a folder</a>
</body>
</html>
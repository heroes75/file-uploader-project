<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="style-header.css">
    <link rel="stylesheet" href="style-home.css">
    <title>HOME</title>
</head>
<body>
    <%- include('partials/header') %>
    <main>
        <div class="main-container">
            <h1>Welcome <%= locals.currentUser?.username || 'to our website' %></h1>
            <% if (locals.currentUser) { %>
                <p><a style="font-size: 25px;" href="/dashboard/<%=currentUser.username%>">Dashboard</a></p>
                <p><a style="color: red; text-decoration: none; font-size: 20px;" href="/logout">LOGOUT</a></p>
            <% } else { %>
                <div class="presentation">
                    <h3>upload your in in our securing database</h3>
                    <p>with our highly secured our files is inviolable. be sure</p>
                    <p><a href="/signup" class="join">Join our universe</a></p>
                </div>
                <p>if you already have an account, <a href="/login">click here</a></p>
            <% } %>
        </div>
    </main>
<script src="/_vercel/insights/script.js" defer></script>
</body>
</html>
<form
    action="<%= locals.folderUrl %>"
    method="post"
    enctype="multipart/form-data"
    id="form"
>
    <label for="fileBackup">Upload your file: </label>
    <input id="input" type="file" name="fileBackup" id="fileBackup" onchange="processSelectedFiles(this)" required/>
    <button id="submit-file" type="submit">Upload</button>
</form>

<% if (locals.folders) { %>
    <% folders.forEach(folder => { %>
     <a style="display: block; margin: 25px; font-size: 20px;" href="<%- folder.folderUrl %>"><%- folder.name %></a>
     <a href="<%= folder.folderUrl %>/update">Rename</a>
     <form style="display: inline;" action="<%= folder.folderUrl %>/delete" method="post"><button type="submit">Delete</button></form>
    <% }) %>
<% } %>
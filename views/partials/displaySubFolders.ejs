<% if (locals.folders) { %>
        <% folders.forEach(folder => { %>
            <div class="folder">
                <a style="font-size: 20px;" href="<%- !locals.isShare ? folder.folderUrl : '/share' + folder.folderUrl + '/' + locals.hash %>">
                    <svg class="folder-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                        <title>folder-outline</title><path d="M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z" />
                    </svg>
                    <%- folder.name %>
                </a>
                <div class="left">
                    <% if (!locals.isShare) { %>
                            <a href="<%= folder.folderUrl %>/update">
                                <svg xmlns="http://www.w3.org/2000/svg" width="30px" height="30px" fill="currentColor" viewBox="0 0 24 24">
                                    <title>rename-box-outline</title>
                                    <path d="M17 17H11.5L13.5 15H17M7 17V14.5L14.9 6.7C15.1 6.5 15.4 6.5 15.6 6.7L17.4 8.5C17.6 8.7 17.6 9 17.4 9.2L9.5 17M19 5V19H5V5H19M19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19V5C21 3.9 20.1 3 19 3Z" />
                                </svg>
                            </a>
                            <a href="/share<%= folder.folderUrl %>/folder">
                                <svg viewBox="0 0 24 24" width="30" height="30" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="css-i6dzq1">
                                    <circle cx="18" cy="5" r="3"></circle>
                                    <circle cx="6" cy="12" r="3"></circle>
                                    <circle cx="18" cy="19" r="3"></circle>
                                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                                </svg>
                            </a>
                            <form style="display: inline;" action="<%= folder.folderUrl %>/delete" method="post">
                                <button type="submit">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="30px" height="30px" fill="red" viewBox="0 0 24 24">
                                        <title>trash-can-outline</title>
                                        <path d="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M7,6H17V19H7V6M9,8V17H11V8H9M13,8V17H15V8H13Z" />
                                    </svg>
                                </button>
                            </form>
                    <% } %>
                </div>
            </div>
        <% }) %>
<% } %>
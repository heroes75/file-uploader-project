<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style-header.css">
    <link rel="stylesheet" href="/style-file-info.css">
    <title><%= file.name %></title>
</head>
<body>
    <%- include('partials/header') %>
    <main>
        <div>
            <a href="<%= parentFolder.folderUrl %>"><%= parentFolder.name %></a>
        </div>
        <div>
            code: <%= file.name %>
        </div>
        <div>
            name: <%= file.originalName %>
        </div>
        <div>
            <%= file.uploadedAt %>
        </div>
        <div>
            Size: <%= file.size %>
        </div>
        <div>
            <form action="/file<%= file.fileUrl %>/download" method="post">
                <button type="submit">Download</button>
            </form>
        </div>
        <div>
            <form action="/file<%= file.fileUrl %>/delete" method="post">
                <button type="submit">Delete this file</button>
            </form>
        </div>
    </main>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style-header.css">
    <link rel="stylesheet" href="/style-file-info.css">
    <title><%= file.name %></title>
</head>
<body>
    <%- include('partials/header') %>
    <main>
        <div>
            <a href="<%= locals.isShare ? parentFolder.shareFolders[0].shareUrl : parentFolder.folderUrl %>"><%= parentFolder.name %></a>
        </div>
        <div>
            code: <%= file.name %>
        </div>
        <div>
            name: <%= file.originalName %>
        </div>
        <div>
            <%= file.uploadedAt %>
        </div>
        <div>
            Size: <%= file.size %> Bytes
        </div>
        <div class="buttons">
            <div>
                <% if (!locals.isShare) { %>
                        <form action="/file<%= file.fileUrl %>/download" method="post">
                    <% } else { %>
                        <form action="<%= file.shareFiles[0].shareFileUrl %>/download" method="post">
                <% } %>
                
                    <button type="submit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="25px" height="25px" viewBox="0 0 24 24">
                            <title>download</title>
                            <path d="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" />
                        </svg>
                        <span>Download</span>
                    </button>
                </form>
            </div>
            <% if (!locals.isShare) { %>
                    <div>
                        <button>
                            <svg viewBox="0 0 24 24" width="25" height="25" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" class="css-i6dzq1">
                                <circle cx="18" cy="5" r="3"></circle>
                                <circle cx="6" cy="12" r="3"></circle>
                                <circle cx="18" cy="19" r="3"></circle>
                                <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                            </svg>
                            <a id="share-link" href="/share<%= file.fileUrl %>/share-file">
                                Share
                            </a>
                        </button>
                    </div>
                    <div>
                        <form action="/file<%= file.fileUrl %>/delete" method="post">
                            <button type="submit">
                                <svg xmlns="http://www.w3.org/2000/svg" width="25px" height="25px" fill="red" viewBox="0 0 24 24">
                                    <title>trash-can</title>
                                    <path d="M9,3V4H4V6H5V19A2,2 0 0,0 7,21H17A2,2 0 0,0 19,19V6H20V4H15V3H9M9,8H11V17H9V8M13,8H15V17H13V8Z" />
                                </svg>
                                <span>Delete</span>
                            </button>
                        </form>
                    </div>
            <% } %>
            
        </div>
    </main>
</body>
</html>
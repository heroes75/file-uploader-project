<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style-header.css">
    <link rel="stylesheet" href="/style-display-folder.css">
    <link rel="stylesheet" href="/style-display-subfolder.css">
    <link rel="stylesheet" href="/style-display-files.css">
    <title><%= locals.folder.name || "Error" %></title>
</head>
<body>
    <%- include('partials/header') %>
    <main>
        <div class="head">
            <% if (locals.parentFolder) { %>
                <a href="<%= !locals.isShare ? locals.parentFolder.folderUrl : locals.parentFolder.shareFolders[0].shareUrl %>"><%= locals.parentFolder.name %></a>
            <% } %>
            <% if (!locals.parentFolder) { %>
                    <h1><%= locals.isShare ? locals.folder.name : 'Dashboard' %></h1>
                <% } else { %>
                    <h1>folders of <%= locals.folder.name %></h1>
            <% } %>
            <% if (!locals.isShare) { %>
                    <a href="<%= locals.folder.folderUrl %>/create">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32px" height="32px" fill="currentColor" viewBox="0 0 24 24">
                            <title>folder-plus-outline</title>
                            <path d="M13 19C13 19.34 13.04 19.67 13.09 20H4C2.9 20 2 19.11 2 18V6C2 4.89 2.89 4 4 4H10L12 6H20C21.1 6 22 6.89 22 8V13.81C21.39 13.46 20.72 13.22 20 13.09V8H4V18H13.09C13.04 18.33 13 18.66 13 19M20 18V15H18V18H15V20H18V23H20V20H23V18H20Z" />
                        </svg>
                        New Folder
                    </a>
            <% } %>
        </div>
        <%- include('partials/displaySubFolders', {folders: locals.folder.folders}) %>
        <%- include('partials/displayFiles', {files: locals.files}) %>
        <% if (currentUser) { %>
                <%- include('partials/errors.ejs', {errors: locals.errors}) %>
                <%- include('partials/uploadForm', {folderUrl: locals.folder.folderUrl}) %>
        <% } %>
    </main>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= locals.folder.name || "Error" %></title>
</head>
<body>
    <% if (locals.parentFolder) { %>
        <a href="<%= locals.parentFolder.folderUrl %>"><%= locals.parentFolder.name %></a>
    <% } %>
    <% if (!locals.parentFolder) { %>
            <h1>Dashboard</h1>
        <% } else { %>
            <h1>folders of <%= locals.folder.name %></h1>
    <% } %>
    
    <%- include('partials/displaySubFolders', {folders: locals.folder.folders}) %>
    <%- include('partials/displayFiles', {files: locals.files}) %>
    <%- include('partials/errors', {errors: locals.errors}) %>
    <%- include('partials/uploadForm', {folderUrl: locals.folder.folderUrl}) %>
    <a href="<%= locals.folder.folderUrl %>/create">Create a sub folder</a>
</body>
</html>
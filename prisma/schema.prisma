// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model Session {
    id        String   @id
    sid       String   @unique
    data      String   @db.Text
    expiresAt DateTime
}

model User {
    id       Int      @id @default(autoincrement())
    username String   @unique @db.VarChar(255)
    password String   @db.VarChar(255)
    folders  Folder[]
}

model Files {
    id                String   @id @default(uuid())
    name              String
    originalName      String
    fileUrl           String   @unique
    size              Int
    uploadedAt        DateTime @default(now())
    destinationFolder Folder   @relation(fields: [folderId], references: [id])
    folderId          String
    destinationId     String
}

model Folder {
    id          String   @id @default(uuid())
    name        String
    destination String   @unique
    folderUrl   String   @unique
    user        User     @relation(fields: [userId], references: [id])
    userId      Int
    parent      Folder?  @relation("folderParent", fields: [parentId], references: [id])
    parentId    String?
    files       Files[]
    folders     Folder[] @relation("folderParent")
}

model ShareFolder {
    id        String   @id @default(cuid())
    shareUrl  String   
    createdAt DateTime @default(now())
    duration  Int
}
